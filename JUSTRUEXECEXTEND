-------------------------------------------------------------------------
local function switchTab(selectedPanel)
	executorPanel.Visible = (selectedPanel == executorPanel)
	workspacePanel.Visible = (selectedPanel == workspacePanel)
	settingsPanel.Visible = (selectedPanel == settingsPanel)
	
	tabExecutorBtn.TextColor3 = executorPanel.Visible and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
	tabWorkspaceBtn.TextColor3 = workspacePanel.Visible and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
	tabSettingsBtn.TextColor3 = settingsPanel.Visible and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
end

tabExecutorBtn.MouseButton1Click:Connect(function() switchTab(executorPanel) end)
tabWorkspaceBtn.MouseButton1Click:Connect(function() 
	switchTab(workspacePanel)
	-- Function defined later
end)
tabSettingsBtn.MouseButton1Click:Connect(function() switchTab(settingsPanel) end)

