local function switchTab(selectedPanel)
	editorPanel.Visible = (selectedPanel == editorPanel)
	workspacePanel.Visible = (selectedPanel == workspacePanel)
	settingsPanel.Visible = (selectedPanel == settingsPanel)
	
	tabEditorBtn.TextColor3 = (selectedPanel == editorPanel) and Color3.fromRGB(0, 220, 130) or Color3.fromRGB(160, 160, 160)
	tabWorkspaceBtn.TextColor3 = (selectedPanel == workspacePanel) and Color3.fromRGB(0, 220, 130) or Color3.fromRGB(160, 160, 160)
	tabSettingsBtn.TextColor3 = (selectedPanel == settingsPanel) and Color3.fromRGB(0, 220, 130) or Color3.fromRGB(160, 160, 160)
	
	if selectedPanel == settingsPanel then
		updateNotebookStats()
	end
end

