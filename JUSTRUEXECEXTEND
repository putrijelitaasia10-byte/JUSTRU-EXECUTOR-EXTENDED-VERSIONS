local function refreshFileList()
	for _, child in ipairs(fileListScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	if listfiles then
		pcall(function()
			local files = listfiles("JustruWorkspace")
			if files then
				for _, filePath in ipairs(files) do
					local fileName = filePath:match("([^/]+)$") or filePath:match("([^\\]+)$")
					
					local fileBtn = Instance.new("TextButton")
					fileBtn.Size = UDim2.new(1, 0, 0, 32)
					fileBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
					fileBtn.TextColor3 = Color3.fromRGB(210, 210, 210)
					fileBtn.TextSize = 13
					fileBtn.Font = Enum.Font.Code
					fileBtn.Text = "  " .. fileName
					fileBtn.TextXAlignment = Enum.TextXAlignment.Left
					fileBtn.Parent = fileListScroll

					local btnCorner = Instance.new("UICorner")
					btnCorner.CornerRadius = UDim.new(0, 4)
					btnCorner.Parent = fileBtn

					fileBtn.MouseButton1Click:Connect(function()
						pcall(function()
							local content = readfile(filePath)
							if content then
								codeBox.Text = content
								fileNameBox.Text = fileName
								switchTab(executorPanel)
							end
						end)
					end)
				end
			end
		end)
	end
end

-- Refresh workspace tab click handler now that function exists
tabWorkspaceBtn.MouseButton1Click:Connect(function()
	switchTab(workspacePanel)
	refreshFileList()
end)

saveBtn.MouseButton1Click:Connect(function()
	local fileName = fileNameBox.Text
	if fileName == "" then
		fileName = "script_" .. math.random(1000, 9999) .. ".lua"
		fileNameBox.Text = fileName
	end
	
	if not string.match(fileName, "%.lua$") then
		fileName = fileName .. ".lua"
	end

	if writefile then
		pcall(function()
			writefile("JustruWorkspace/" .. fileName, codeBox.Text)
			refreshFileList()
		end)
	end
end)

executeBtn.MouseButton1Click:Connect(function()
